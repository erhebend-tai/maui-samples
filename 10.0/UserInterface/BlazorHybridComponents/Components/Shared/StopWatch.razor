@implements IDisposable

@* Stopwatch using System.Threading.Timer to exercise async UI updates. *@

<div class="stopwatch">
    <div class="stopwatch-display" data-testid="stopwatch-value">@FormatElapsed()</div>
    <div class="stopwatch-controls">
        @if (!_running)
        {
            <button class="btn btn-primary" @onclick="Start">Start</button>
        }
        else
        {
            <button class="btn btn-secondary" @onclick="Stop">Stop</button>
        }
        <button class="btn btn-ghost" @onclick="Reset">Reset</button>
    </div>
</div>

@code {
    private System.Threading.Timer? _timer;
    private TimeSpan _elapsed = TimeSpan.Zero;
    private DateTime _startedAt;
    private bool _running;

    private void Start()
    {
        if (_running) return;
        _running = true;
        _startedAt = DateTime.UtcNow - _elapsed;
        _timer = new System.Threading.Timer(_ =>
        {
            _elapsed = DateTime.UtcNow - _startedAt;
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.Zero, TimeSpan.FromMilliseconds(100));
    }

    private void Stop()
    {
        _running = false;
        _timer?.Dispose();
        _timer = null;
    }

    private void Reset()
    {
        Stop();
        _elapsed = TimeSpan.Zero;
    }

    private string FormatElapsed() => $"{(int)_elapsed.TotalMinutes:D2}:{_elapsed.Seconds:D2}.{_elapsed.Milliseconds / 100}";

    public void Dispose() => _timer?.Dispose();
}
