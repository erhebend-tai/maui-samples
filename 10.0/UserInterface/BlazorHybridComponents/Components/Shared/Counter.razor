@* Classic counter demo with increment, decrement, and reset. *@

<div class="counter">
    <div class="counter-display" data-testid="counter-value">@_count</div>
    <div class="counter-controls">
        <button class="btn btn-secondary" @onclick="Decrement">−</button>
        <button class="btn btn-primary" @onclick="Increment">+</button>
        <button class="btn btn-ghost" @onclick="Reset">Reset</button>
    </div>
    <p class="counter-step">
        Step:
        <input type="number" min="1" max="100" @bind="_step" />
    </p>
</div>

@code {
    private int _count;
    private int _step = 1;

    private void Increment() => _count += _step;
    private void Decrement() => _count -= _step;
    private void Reset() => _count = 0;
}
